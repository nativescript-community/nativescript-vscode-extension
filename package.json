{
  "name": "nativescript",
  "version": "0.12.5",
  "minNativescriptCliVersion": "8.0.0",
  "icon": "images/icon.png",
  "displayName": "NativeScript",
  "description": "NativeScript support for Visual Studio Code",
  "galleryBanner": {
    "color": "#65adf1",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nativescript-community/nativescript-vscode-extension/"
  },
  "publisher": "NativeScript",
  "bugs": "https://github.com/nativescript-community/nativescript-vscode-extension/issues",
  "engines": {
    "vscode": "^1.109.0"
  },
  "homepage": "https://www.nativescript.org/",
  "categories": [
    "Debuggers",
    "Other"
  ],
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/vscode": "~1.109.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "clean": "git clean -fdx",
    "build": "tsc -p ./src/tsconfig.build.json",
    "build:watch": "tsc -w -p ./src/tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p ./src --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "full-build": "npm run clean && npm install && npm run build && npm run package",
    "vscode:prepublish": "npm run clean:out && npm run build && node scripts/write-ga-config.mjs",
    "clean:out": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\""
  },
  "main": "./out/main",
  "activationEvents": [
    "onDebugResolve:nativescript"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "NativeScript Extension Configurations",
      "properties": {
        "nativescript.analytics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage statistics to help improve the NativeScript extension."
        },
        "nativescript.nsPath": {
          "type": "string",
          "description": "Path to the NativeScript CLI executable. Relative paths are resolved against the app root. When not set, a CLI installed in the project (node_modules/.bin/ns, also searched in parent folders) is used, falling back to the global 'ns'."
        },
        "nativescript.tnsPath": {
          "type": "string",
          "description": "Path to the NativeScript CLI executable.",
          "markdownDeprecationMessage": "Use `#nativescript.nsPath#` instead. Still honored when `nativescript.nsPath` is not set."
        },
        "nativescript.iosTeamId": {
          "type": "string",
          "description": "The iOS development Team ID."
        }
      }
    },
    "commands": [
      {
        "command": "nativescript.runIos",
        "title": "Run on iOS",
        "category": "NativeScript"
      },
      {
        "command": "nativescript.runAndroid",
        "title": "Run on Android",
        "category": "NativeScript"
      },
      {
        "command": "nativescript.showOutputChannel",
        "title": "Show Output Channel",
        "category": "NativeScript"
      }
    ],
    "keybindings": [
      {
        "command": "nativescript.runIos",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "nativescript.runAndroid",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "nativescript.showOutputChannel",
        "key": "ctrl+alt+n ctrl+alt+o",
        "mac": "cmd+alt+n cmd+alt+o"
      }
    ],
    "debuggers": [
      {
        "type": "nativescript",
        "label": "NativeScript",
        "languages": [
          "javascript",
          "typescript"
        ],
        "initialConfigurations": [
          {
            "name": "Launch on iOS",
            "type": "nativescript",
            "request": "launch",
            "platform": "ios",
            "appRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "watch": true
          },
          {
            "name": "Test on iOS",
            "type": "nativescript",
            "request": "launch",
            "platform": "ios",
            "appRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "watch": false,
            "stopOnEntry": true,
            "launchTests": true,
            "tnsArgs": [
              "--justlaunch"
            ]
          },
          {
            "name": "Attach on iOS",
            "type": "nativescript",
            "request": "attach",
            "platform": "ios",
            "appRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "watch": false
          },
          {
            "name": "Launch on Android",
            "type": "nativescript",
            "request": "launch",
            "platform": "android",
            "appRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "watch": true
          },
          {
            "name": "Test on Android",
            "type": "nativescript",
            "request": "launch",
            "platform": "android",
            "appRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "watch": false,
            "stopOnEntry": true,
            "launchTests": true,
            "tnsArgs": [
              "--justlaunch"
            ]
          },
          {
            "name": "Attach on Android",
            "type": "nativescript",
            "request": "attach",
            "platform": "android",
            "appRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "watch": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "NativeScript: Launch on iOS",
            "description": "A configuration for launching an app on iOS device/emulator",
            "body": {
              "name": "Launch on iOS",
              "type": "nativescript",
              "request": "launch",
              "platform": "ios",
              "appRoot": "^\"\\${workspaceFolder}\"",
              "sourceMaps": true,
              "watch": true
            }
          },
          {
            "label": "NativeScript: Launch on Android",
            "description": "A configuration for launching an app on Android device/emulator",
            "body": {
              "name": "Launch on Android",
              "type": "nativescript",
              "request": "launch",
              "platform": "android",
              "appRoot": "^\"\\${workspaceFolder}\"",
              "sourceMaps": true,
              "watch": true
            }
          },
          {
            "label": "NativeScript: Attach on iOS",
            "description": "A configuration for attaching to an already running iOS app",
            "body": {
              "name": "Attach on iOS",
              "type": "nativescript",
              "request": "attach",
              "platform": "ios",
              "appRoot": "^\"\\${workspaceFolder}\"",
              "sourceMaps": true,
              "watch": false
            }
          },
          {
            "label": "NativeScript: Attach on Android",
            "description": "A configuration for attaching to an already running Android app",
            "body": {
              "name": "Attach on Android",
              "type": "nativescript",
              "request": "attach",
              "platform": "android",
              "appRoot": "^\"\\${workspaceFolder}\"",
              "sourceMaps": true,
              "watch": false
            }
          },
          {
            "label": "NativeScript: Launch with a custom command (e.g. Nx)",
            "description": "Runs your own command (for example an Nx debug target) and attaches the debugger to it",
            "body": {
              "name": "Launch on iOS (Nx)",
              "type": "nativescript",
              "request": "launch",
              "platform": "ios",
              "appRoot": "^\"\\${workspaceFolder}/apps/${1:my-app}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "runtimeExecutable": "npx",
              "runtimeArgs": [
                "nx",
                "debug",
                "${1:my-app}",
                "--platform=ios"
              ],
              "watch": true
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "ios",
                  "android"
                ],
                "description": "Target platform."
              },
              "appRoot": {
                "type": "string",
                "description": "Absolute path to the root folder of the NativeScript app. Defaults to the first workspace folder.",
                "default": "${workspaceFolder}"
              },
              "tnsArgs": {
                "type": "array",
                "description": "Extra arguments passed to the NativeScript CLI.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "runtimeExecutable": {
                "type": "string",
                "description": "Command to run instead of the NativeScript CLI, e.g. 'npx'. When set, the command runs exactly as given by runtimeExecutable and runtimeArgs: the extension adds no flags (watch, stopOnEntry, tnsArgs, ...), so pass them in runtimeArgs. The command's output must include the CLI's debug port lines."
              },
              "runtimeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for runtimeExecutable. Each entry is passed as a single argument.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the command. Relative paths resolve against the workspace folder. Defaults to appRoot."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "Environment variables for the command. A null value removes the variable.",
                "default": {}
              },
              "watch": {
                "type": "boolean",
                "description": "Rebuild and reattach the debugger when files change.",
                "default": true
              },
              "address": {
                "type": "string",
                "description": "Host the debugger connects to. Defaults to 'localhost' on iOS and '127.0.0.1' on Android."
              },
              "sourceMaps": {
                "type": "boolean",
                "description": "Use JavaScript source maps (if they exist).",
                "default": true
              },
              "sourceMapPathOverrides": {
                "type": "object",
                "description": "Mappings for rewriting source map locations to local paths. Merged over the defaults computed for the project.",
                "default": {}
              },
              "resolveSourceMapLocations": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Glob patterns for locations source maps may be loaded from. Defaults to null (any location), since maps on a device are not under the app root."
              },
              "skipFiles": {
                "type": "array",
                "description": "Glob patterns for files to skip when stepping.",
                "items": {
                  "type": "string"
                },
                "default": [
                  "<node_internals>/**"
                ]
              },
              "smartStep": {
                "type": "boolean",
                "description": "Automatically step through code that has no source mapping.",
                "default": true
              },
              "trace": {
                "type": [
                  "boolean",
                  "object"
                ],
                "description": "Enable js-debug's diagnostic logging.",
                "default": false
              },
              "diagnosticLogging": {
                "type": "boolean",
                "default": false,
                "deprecationMessage": "Use 'trace' instead."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first line after launch.",
                "default": false
              },
              "launchTests": {
                "type": "boolean",
                "description": "Run the app's unit tests (ns test) instead of the app itself.",
                "default": false
              }
            }
          },
          "attach": {
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "ios",
                  "android"
                ],
                "description": "Target platform."
              },
              "appRoot": {
                "type": "string",
                "description": "Absolute path to the root folder of the NativeScript app. Defaults to the first workspace folder.",
                "default": "${workspaceFolder}"
              },
              "tnsArgs": {
                "type": "array",
                "description": "Extra arguments passed to the NativeScript CLI.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "runtimeExecutable": {
                "type": "string",
                "description": "Command to run instead of the NativeScript CLI, e.g. 'npx'. When set, the command runs exactly as given by runtimeExecutable and runtimeArgs: the extension adds no flags (watch, stopOnEntry, tnsArgs, ...), so pass them in runtimeArgs. The command's output must include the CLI's debug port lines."
              },
              "runtimeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for runtimeExecutable. Each entry is passed as a single argument.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the command. Relative paths resolve against the workspace folder. Defaults to appRoot."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "Environment variables for the command. A null value removes the variable.",
                "default": {}
              },
              "watch": {
                "type": "boolean",
                "description": "Rebuild and reattach the debugger when files change.",
                "default": false
              },
              "address": {
                "type": "string",
                "description": "Host the debugger connects to. Defaults to 'localhost' on iOS and '127.0.0.1' on Android."
              },
              "sourceMaps": {
                "type": "boolean",
                "description": "Use JavaScript source maps (if they exist).",
                "default": true
              },
              "sourceMapPathOverrides": {
                "type": "object",
                "description": "Mappings for rewriting source map locations to local paths. Merged over the defaults computed for the project.",
                "default": {}
              },
              "resolveSourceMapLocations": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Glob patterns for locations source maps may be loaded from. Defaults to null (any location), since maps on a device are not under the app root."
              },
              "skipFiles": {
                "type": "array",
                "description": "Glob patterns for files to skip when stepping.",
                "items": {
                  "type": "string"
                },
                "default": [
                  "<node_internals>/**"
                ]
              },
              "smartStep": {
                "type": "boolean",
                "description": "Automatically step through code that has no source mapping.",
                "default": true
              },
              "trace": {
                "type": [
                  "boolean",
                  "object"
                ],
                "description": "Enable js-debug's diagnostic logging.",
                "default": false
              },
              "diagnosticLogging": {
                "type": "boolean",
                "default": false,
                "deprecationMessage": "Use 'trace' instead."
              }
            }
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "javascript"
      },
      {
        "language": "typescript"
      }
    ]
  }
}
